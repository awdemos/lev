    "review::.::holistic::error_consistency::cli-keyerror-message": {
      "id": "review::.::holistic::error_consistency::cli-keyerror-message",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Missing 'questions' key surfaces as bare key repr with no structural context",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "lev/cli.py"
        ],
        "evidence": [
          "In cli.py, `questions = payload[\"questions\"]` can raise KeyError, and the except (ValueError, KeyError, OSError) handler prints f\"lev: error: {exc}\" - producing 'lev: error: \\'questions\\'' with no indication the key was expected in the questions file"
        ],
        "suggestion": "Use payload.get(\"questions\") and raise ValueError(\"questions file must contain a 'questions' list\") when missing, so all failures flow through the descriptive ValueError path and the KeyError branch can be dropped.",
        "reasoning": "",
        "summary_hash": "2df78130"
      },
      "status": "fixed",
