    "review::.::holistic::contract_coherence::raw_choice_scores_param_name_mismatch": {
      "id": "review::.::holistic::contract_coherence::raw_choice_scores_param_name_mismatch",
      "detector": "review",
      "file": ".",
      "tier": 3,
      "confidence": "low",
      "summary": "raw_choice_scores names its first parameter 'state' but callers pass a token Counter, not the state string",
      "detail": {
        "holistic": true,
        "dimension": "contract_coherence",
        "related_files": [
          "lev/engine.py",
          "lev/loop.py"
        ],
        "evidence": [
          "lev/engine.py:67 declares def raw_choice_scores(state: Counter, labels: dict[str, str]) but the only caller, lev/loop.py _classify_choice, passes tokens = tokenize(state), i.e. a Counter produced from the state text",
          "The name 'state' suggests the raw text accepted by classify/tokenize, so a reader calling this helper directly would reasonably pass a string and get a TypeError"
        ],
        "suggestion": "Rename the parameter from 'state' to 'tokens' in lev/engine.py:67 (and update the body reference), matching what callers actually supply.",
        "reasoning": "",
        "summary_hash": "e1cb2ee6"
      },
      "status": "fixed",
